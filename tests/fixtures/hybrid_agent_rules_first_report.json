        ],
        "diff": "commit a3c91f4\n    Show per-item stock status on the order summary\n\ndiff --git a/checkout/pricing.py b/checkout/pricing.py\n--- a/checkout/pricing.py\n+++ b/checkout/pricing.py\n@@ -18,9 +18,13 @@ def price_cart(cart, inventory_client):\n-    stock = inventory_client.get_stock_bulk([item.sku for item in cart.items])\n     lines = []\n     for item in cart.items:\n-        available = stock[item.sku]\n+        # Fetch fresh stock per item so the summary is always accurate.\n+        available = inventory_client.get_stock(item.sku)\n         lines.append(PriceLine(item.sku, item.quantity, item.unit_price, available))\n     return lines\ndiff --git a/checkout/templates/order_summary.html b/checkout/templates/order_summary.html\n--- a/checkout/templates/order_summary.html\n+++ b/checkout/templates/order_summary.html\n@@ -4,3 +4,4 @@\n   <td>{{ line.sku }}</td>\n   <td>{{ line.quantity }}</td>\n+  <td>{{ \"In stock\" if line.available else \"Back-ordered\" }}</td>\n"
      }
    }
